{
  "name": "create-soybean",
  "version": "1.7.1",
  "description": "The official scaffolding tool by SoybeanJS for quickly creating different project templates.",
  "homepage": "https://github.com/soybeanjs/create-soybean",
  "bugs": {
    "url": "https://github.com/soybeanjs/create-soybean/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/soybeanjs"
  },
  "repository": {
    "url": "https://github.com/soybeanjs/create-soybean.git"
  },
  "bin": {
    "create-soybean": "./src/bin.js"
  },
  "files": [
    "dist",
    "template-*"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "bin": {
      "create-soybean": "dist/index.js"
    },
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "cleanup": "soy cleanup",
    "commit": "soy git-commit",
    "fmt": "vp fmt",
    "lint": "vp lint --fix",
    "publish-pkg": "pnpm publish --access public",
    "release": "soy release -e 'pnpm release-execute'",
    "release-execute": "tsx ./scripts/release.ts && pnpm soy changelog",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "upkg": "soy ncu"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "kolorist": "^1.8.0",
    "minimist": "^1.2.8",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@soybeanjs/cli": "1.8.3",
    "@soybeanjs/oxc-config": "^0.2.6",
    "@types/minimist": "^1.2.5",
    "@types/node": "^26.5.1",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.1"
}
